@model List<ListarMedicamentoViewModel>

@{
    ViewBag.Titulo = "Listagem de Medicamentos";
}

<p>
    <a class="btn btn-primary" asp-action="Cadastrar">
        <i class="bi bi-patch-plus"></i>
        Cadastrar medicamento
    </a>
</p>

@if (Model.Count == 0)
{
    <div class="alert alert-warning mt-4" role="alert">
        Não há nenhum medicamento registrado.
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 row-cols-xl-4 g-3 mt-4">
        @foreach (ListarMedicamentoViewModel m in Model)
        {
            <div class="col">
                <div class="card h-100 @(m.EmFalta ? "border-danger" : "")">
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <h5>@m.Nome</h5>
                            <span class="badge text-bg-secondary">@m.Id</span>
                        </div>

                        <p class="card-text text-body-secondary">@m.Descricao</p>

                        <dl class="row mb-2">
                            <dt class="col-sm-5">Fornecedor</dt>
                            <dd class="col-sm-7">@m.NomeFornecedor</dd>

                            <dt class="col-sm-5">Estoque</dt>
                            <dd class="col-sm-7">
                                @m.QuantidadeEmEstoque

                                @if (m.EmFalta)
                                {
                                    <span class="badge text-bg-danger ms-1">
                                        <i class="bi bi-exclamation-triangle"></i>
                                        Em falta
                                    </span>
                                }
                            </dd>
                        </dl>

                        <div class="d-flex gap-2 justify-content-end mt-auto">
                            <a class="btn btn-sm btn-outline-primary" title="Editar" asp-action="Editar" asp-route-id="@m.Id">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <a class="btn btn-sm btn-outline-danger" title="Excluir" asp-action="Excluir" asp-route-id="@m.Id">
                                <i class="bi bi-trash3"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
