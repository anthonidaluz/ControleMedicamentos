@model EditarPacienteViewModel

@{
    ViewBag.Titulo = "Edição de Paciente";
}

<div class="row justify-content-start">
    <form class="col-lg-6" asp-action="Editar" asp-route-id="@Model.Id" method="post">
        <div>
            <label class="form-label" asp-for="Nome"></label>
            <input class="form-control" asp-for="Nome" type="text">
            <span class="text-danger" asp-validation-for="Nome"></span>
        </div>

        <div class="mt-4">
            <label class="form-label" asp-for="Telefone"></label>
            <input class="form-control" asp-for="Telefone" type="text" placeholder="(00) 90000-0000">
            <span class="text-danger" asp-validation-for="Telefone"></span>
        </div>

        <div class="mt-4">
            <label class="form-label" asp-for="CartaoSus">Cartão do SUS</label>
            <input class="form-control" asp-for="CartaoSus" type="text" inputmode="numeric" maxlength="15" placeholder="000000000000000">
            <span class="text-danger" asp-validation-for="CartaoSus"></span>
        </div>

        <div class="mt-4">
            <label class="form-label" asp-for="Cpf">CPF</label>
            <input class="form-control" asp-for="Cpf" type="text" inputmode="numeric" maxlength="11" placeholder="00000000000">
            <span class="text-danger" asp-validation-for="Cpf"></span>
        </div>

        <div class="d-flex gap-3 mt-4">
            <button class="btn btn-primary" type="submit">
                <i class="bi bi-check"></i>
                Confirmar edição
            </button>
            <a class="btn btn-outline-secondary" asp-action="Listar">
                <i class="bi bi-arrow-return-left"></i>
                Voltar para a lista
            </a>
        </div>
    </form>
</div>
