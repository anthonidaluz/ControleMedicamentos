@model List<ListarPacienteViewModel>

@{
    ViewBag.Titulo = "Listagem de Pacientes";
}

<p>
    <a class="btn btn-primary" asp-action="Cadastrar">
        <i class="bi bi-person-plus"></i>
        Cadastrar paciente
    </a>
</p>

@if (Model.Count == 0)
{
    <div class="alert alert-warning mt-4" role="alert">
        Não há nenhum paciente registrado.
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 row-cols-xl-4 g-3 mt-4">
        @foreach (ListarPacienteViewModel p in Model)
        {
            <div class="col">
                <div class="card h-100">
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <h5>@p.Nome</h5>
                            <span class="badge text-bg-secondary">@p.Id</span>
                        </div>

                        <dl class="row mb-2">
                            <dt class="col-sm-4">Telefone</dt>
                            <dd class="col-sm-8">@p.Telefone</dd>

                            <dt class="col-sm-4">Cartão SUS</dt>
                            <dd class="col-sm-8">@p.CartaoSus</dd>

                            <dt class="col-sm-4">CPF</dt>
                            <dd class="col-sm-8">@p.Cpf</dd>
                        </dl>

                        <div class="d-flex gap-2 justify-content-end mt-auto">
                            <a class="btn btn-sm btn-outline-primary" title="Editar" asp-action="Editar" asp-route-id="@p.Id">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <a class="btn btn-sm btn-outline-danger" title="Excluir" asp-action="Excluir" asp-route-id="@p.Id">
                                <i class="bi bi-trash3"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
