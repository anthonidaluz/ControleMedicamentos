@model List<ListarRequisicaoSaidaViewModel>

@{
    ViewBag.Titulo = "Requisições de Saída";
}

<p>
    <a class="btn btn-primary" asp-action="Cadastrar">
        <i class="bi bi-box-arrow-up"></i>
        Registrar saída
    </a>
</p>

@if (Model.Count == 0)
{
    <div class="alert alert-warning mt-4" role="alert">
        Não há nenhuma requisição de saída registrada.
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 row-cols-xl-4 g-3 mt-4">
        @foreach (ListarRequisicaoSaidaViewModel r in Model)
        {
            <div class="col">
                <div class="card h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <h5>@r.NomeMedicamento</h5>
                            <span class="badge text-bg-secondary">@r.Id</span>
                        </div>

                        <dl class="row mb-0">
                            <dt class="col-sm-5">Paciente</dt>
                            <dd class="col-sm-7">@r.NomePaciente</dd>

                            <dt class="col-sm-5">Quantidade</dt>
                            <dd class="col-sm-7">
                                <span class="badge text-bg-danger">-@r.Quantidade</span>
                            </dd>

                            <dt class="col-sm-5">Data</dt>
                            <dd class="col-sm-7">@r.Data.ToString("dd/MM/yyyy")</dd>
                        </dl>
                    </div>
                </div>
            </div>
        }
    </div>
}
