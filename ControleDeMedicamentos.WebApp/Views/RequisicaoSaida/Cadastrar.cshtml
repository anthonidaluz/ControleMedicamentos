@model CadastrarRequisicaoSaidaViewModel

@{
    ViewBag.Titulo = "Registro de Requisição de Saída";
}

<div class="row justify-content-start">
    <form class="col-lg-6" asp-action="Cadastrar" method="post">
        <div>
            <label class="form-label" asp-for="MedicamentoId">Medicamento</label>
            <select class="form-select" asp-for="MedicamentoId">
                <option value="0">Selecione um medicamento</option>
                @foreach (OpcaoRequisicaoSaidaViewModel m in Model.Medicamentos)
                {
                    <option value="@m.Id">@m.Nome</option>
                }
            </select>
            <span class="text-danger" asp-validation-for="MedicamentoId"></span>
        </div>

        <div class="mt-4">
            <label class="form-label" asp-for="PacienteId">Paciente</label>
            <select class="form-select" asp-for="PacienteId">
                <option value="0">Selecione um paciente</option>
                @foreach (OpcaoRequisicaoSaidaViewModel p in Model.Pacientes)
                {
                    <option value="@p.Id">@p.Nome</option>
                }
            </select>
            <span class="text-danger" asp-validation-for="PacienteId"></span>
        </div>

        <div class="row mt-4">
            <div class="col-sm-6">
                <label class="form-label" asp-for="Quantidade"></label>
                <input class="form-control" asp-for="Quantidade" type="number" min="1">
                <span class="text-danger" asp-validation-for="Quantidade"></span>
            </div>

            <div class="col-sm-6 mt-4 mt-sm-0">
                <label class="form-label" asp-for="Data"></label>
                <input class="form-control" asp-for="Data" type="date">
                <span class="text-danger" asp-validation-for="Data"></span>
            </div>
        </div>

        <div class="d-flex gap-3 mt-4">
            <button class="btn btn-primary" type="submit">
                <i class="bi bi-check"></i>
                Registrar
            </button>
            <a class="btn btn-outline-secondary" asp-action="Listar">
                <i class="bi bi-arrow-return-left"></i>
                Voltar para a lista
            </a>
        </div>
    </form>
</div>
